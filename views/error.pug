extends layout

block content
  - const errorStatus = typeof status !== 'undefined' && status ? status : null
  - const errorTitle = (typeof title !== 'undefined' && title) || translate('Something went wrong')
  - const errorMessage = (typeof message !== 'undefined' && message) || translate('The page could not be loaded. Please try again later.')
  p.eyebrow= translate('TrackerControl for iOS')
  if errorStatus
    p.error-status= errorStatus
  h1= errorTitle
  .notice.notice--warning(role='alert')
    p= errorMessage
  p.page-links
    a(href=localize('/')) ← #{translate('Back to home')}

block app
