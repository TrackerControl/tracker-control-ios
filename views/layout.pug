doctype html
- const safeTitle = (typeof title !== 'undefined' && title) || 'TrackerControl for iOS'
- const safeSiteName = (typeof siteName !== 'undefined' && siteName) || 'TrackerControl for iOS'
- const safeDescription = (typeof pageDescription !== 'undefined' && pageDescription) || null
- const safeCanonical = (typeof canonicalUrl !== 'undefined' && canonicalUrl) || null
- const safeOgTitle = (typeof ogTitle !== 'undefined' && ogTitle) || safeTitle
- const safeOgType = (typeof ogType !== 'undefined' && ogType) || 'website'
- const safeOgImage = (typeof ogImage !== 'undefined' && ogImage) || null
- const searchData = (typeof data !== 'undefined' && data) || {}
- const current = (typeof currentPath !== 'undefined' && currentPath) || ''
html(lang='en-GB')
  head
    meta(charset='utf-8')
    meta(name='viewport' content='width=device-width, initial-scale=1')
    title= `${safeTitle} | ${safeSiteName}`
    if safeDescription
      meta(name='description' content=safeDescription)
    if safeCanonical
      link(rel='canonical' href=safeCanonical)
    meta(property='og:site_name' content=safeSiteName)
    meta(property='og:type' content=safeOgType)
    meta(property='og:title' content=safeOgTitle)
    if safeDescription
      meta(property='og:description' content=safeDescription)
    if safeCanonical
      meta(property='og:url' content=safeCanonical)
    if safeOgImage
      meta(property='og:image' content=safeOgImage)
    meta(name='twitter:card' content='summary')
    meta(name='twitter:title' content=safeOgTitle)
    if safeDescription
      meta(name='twitter:description' content=safeDescription)
    if safeOgImage
      meta(name='twitter:image' content=safeOgImage)
    link(rel='stylesheet' href='/css/styles.css')
    link(rel='icon' type='image/png' href='/images/trackercontrol.png')
  body
    a.skip-link(href='#main-content') Skip to content
    .platform-header
      nav.platform-nav.site-width(aria-label='TrackerControl websites')
        a(href='https://trackercontrol.org/') Project
        a(href='https://trackercontrol.org/#android') Android app
        a.is-current(href='/' aria-current='true') iOS app reports
    header.site-header.site-width
      a.wordmark(href='/' aria-label='TrackerControl for iOS homepage')
        img.wordmark__icon(src='/images/trackercontrol.png' alt='' width='36' height='36')
        span TrackerControl
        small for iOS
      nav.site-nav(aria-label='Main navigation')
        a(href='/#search' class=current === '/search' ? 'is-current' : undefined aria-current=current === '/search' ? 'page' : undefined) Search
        a(href='/' class=current === '/' ? 'is-current' : undefined aria-current=current === '/' ? 'page' : undefined) Home
        a(href='/trackers' class=current.startsWith('/tracker') || current === '/trackers' ? 'is-current' : undefined aria-current=current.startsWith('/tracker') || current === '/trackers' ? 'page' : undefined) Trackers
        a(href='/companies' class=current.startsWith('/company') || current === '/companies' ? 'is-current' : undefined aria-current=current.startsWith('/company') || current === '/companies' ? 'page' : undefined) Companies
        a(href='/statistics' class=current === '/statistics' ? 'is-current' : undefined aria-current=current === '/statistics' ? 'page' : undefined) Statistics
        a(href='/about' class=current === '/about' ? 'is-current' : undefined aria-current=current === '/about' ? 'page' : undefined) About
      form.nav-search(action='/search' method='GET' role='search')
        label.sr-only(for='nav-search') Search apps
        input#nav-search(type='search' name='search' value=searchData.search || '' placeholder='Search apps' autocomplete='off')
        button.button.button--small(type='submit') Search
    main#main-content
      if typeof app === 'undefined'
        .site-width.page-content
          block content
      block app
    footer.site-footer
      .site-width.site-footer__inner
        a.wordmark.wordmark--footer(href='/')
          img.wordmark__icon(src='/images/trackercontrol.png' alt='' width='28' height='28')
          span TrackerControl
          small for iOS
        nav(aria-label='Footer navigation')
          a(href='https://trackercontrol.org/') TrackerControl project
          a(href='/about#contact') Contact
          a(href='mailto:ios@trackercontrol.org') Suggest a correction
          a(href='https://github.com/TrackerControl/tracker-control-ios' target='_blank' rel='noopener noreferrer') Source on GitHub
      p.site-width.site-footer__credit
        = 'Maintained by '
        a(href='https://kollnig.net/') Konrad Kollnig
        | , Maastricht University.
    script(src='/js/filter.js' defer)
    script(src='/js/site.js' defer)
    block scripts
