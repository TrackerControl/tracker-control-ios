extends layout

block content
  - const directoryKind = (typeof kind !== 'undefined' && kind) || 'tracker'
  - const isTracker = directoryKind === 'tracker'
  - const directoryEntries = (typeof entries !== 'undefined' && entries) || []
  - const total = typeof totalApps !== 'undefined' ? totalApps : 0
  - const tracked = typeof trackedApps !== 'undefined' ? trackedApps : 0
  - const directoryLatest = typeof latestAnalysis !== 'undefined' ? latestAnalysis : null
  - const safeDate = (value) => localizedDate(value, { day: 'numeric', month: 'short', year: 'numeric' })
  h1= translate(isTracker ? 'Tracker directory' : 'Company directory')
  if directoryEntries.length > 0
    p.lede
      if isTracker
        = translate('Every tracker signature detected across {{total}} analysed iOS apps. Select one to see the apps in which it was found.', { total })
      else
        = translate('Every company whose tracking code was detected across {{total}} analysed iOS apps, ranked by reach.', { total })
    p.section-note
      = translate(directoryLatest && safeDate(directoryLatest) ? '{{tracked}} of {{total}} analysed apps contain at least one detected third-party tracker. Last analysis: {{date}}.' : '{{tracked}} of {{total}} analysed apps contain at least one detected third-party tracker.', { tracked, total, date: safeDate(directoryLatest) })
      = ' '
      a(href=localize('/about#how-it-works'))= translate('See how these numbers are produced')
      | .

    .directory-controls
      label(for='directory-filter')= translate(isTracker ? 'Filter trackers or companies' : 'Filter companies')
      input#directory-filter(type='search' placeholder=translate(isTracker ? 'Filter trackers or companies' : 'Filter companies') aria-controls='directory-table' data-filter-target='#directory-table' autocomplete='off')
      p#directory-count.result-count(role='status' aria-live='polite')= translate(directoryEntries.length === 1 ? '{{count}} entry' : '{{count}} entries', { count: directoryEntries.length })

    .table-scroll(role='region' tabindex='0' aria-label=translate(isTracker ? 'Tracker directory table' : 'Company directory table'))
      table#directory-table.data-table
        caption= translate(isTracker ? 'Tracker directory' : 'Company directory')
        thead
          tr
            th(scope='col')= translate('Rank')
            th(scope='col')= translate(isTracker ? 'Tracker' : 'Company')
            th(scope='col')= translate(isTracker ? 'Company' : 'Trackers')
            th(scope='col')= translate('Country')
            th(scope='col')= translate('Region')
            th(scope='col')= translate('Apps')
            th(scope='col')= translate('Share')
        tbody
          each entry, index in directoryEntries
            - const entryName = entry.name || translate('Unknown')
            - const haystack = `${entryName} ${isTracker ? (entry.company || '') : ''} ${entry.countryName || ''} ${entry.region || ''}`.toLowerCase()
            tr(data-filter=haystack)
              td= index + 1
              td
                a.entry-link(href=localize(`/${directoryKind}/${entry.slug}`))= entryName
                if isTracker && entry.system
                    span.status-label= translate('System API')
              td
                if isTracker
                  if entry.company && entry.companySlug
                    a(href=localize(`/company/${entry.companySlug}`))= entry.company
                  else if entry.company
                    = entry.company
                  else if entry.system
                    span.muted= translate('Apple platform API')
                  else
                    span.muted= translate('Unattributed')
                else
                  = entry.trackers ? entry.trackers.length : 0
              td= entry.countryName ? translate(entry.countryName) : translate('Unknown')
              td= entry.region ? translate(entry.region) : translate('Unresolved')
              td= entry.appCount === undefined ? translate('Unavailable') : entry.appCount
              td= entry.pct === undefined ? translate('Unavailable') : `${entry.pct}%`
    p#directory-empty.notice.notice--quiet(hidden)= translate('No entries match that filter.')
    p.section-note
      if isTracker
        = translate('A tracker is counted once per app, regardless of how many times its code appears. “System API” marks Apple platform APIs reported by the analyser and excluded from the third-party tracker count. “Unattributed” marks signatures that could not be mapped to a company.')
      else
        = translate('Companies are counted at the level of the ultimate parent, so subsidiaries are grouped under their owner. An app is counted once per company even when several of that company’s trackers are present.')
  else
    .notice.notice--warning(role='status')
      p= translate('Directory data is not available right now. Please try again later.')

block app
